{
  "name": "vite-project",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "staging": "vite build --mode staging",
    "build": "vite build --mode production",
    "deploy:staging": "node ./scripts/deploy-h5.cjs --mode staging",
    "deploy:production": "node ./scripts/deploy-h5.cjs --mode production",
    "preview": "vite preview",
    "preinstall": "only-allow pnpm",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:ts": "vue-tsc",
    "lint:style": "stylelint \"**/*.{scss,vue}\""
  },
  "dependencies": {
    "axios": "^1.7.4",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "pinia": "^2.2.2",
    "qs": "^6.13.0",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.19.45",
    "@types/qs": "^6.9.15",
    "@vitejs/plugin-vue": "^5.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "minimist": "^1.2.8",
    "node-deploy": "git+https://git@github.com/beansmile/node-deploy.git",
    "only-allow": "^1.2.1",
    "postcss-html": "^1.7.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.77.8",
    "stylelint": "^14.16.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.5.4",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^4.5.3",
    "vite-plugin-checker": "^0.7.2",
    "vue-tsc": "^2.0.29"
  }
}
