{
  "name": "vite-project",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "staging": "vue-tsc && vite build --mode staging",
    "build": "vue-tsc && vite build --mode production",
    "deploy:staging": "node ./scripts/deploy-h5.cjs --mode staging",
    "deploy:production": "node ./scripts/deploy-h5.cjs --mode production",
    "preview": "vite preview",
    "preinstall": "only-allow pnpm",
    "lint": "eslint .",
    "lint:ts": "vue-tsc",
    "lint:style": "stylelint **/*.{scss,vue}"
  },
  "dependencies": {
    "axios": "^1.3.2",
    "dayjs": "^1.11.7",
    "lodash-es": "^4.17.21",
    "qs": "^6.11.0",
    "vue": "^3.2.45",
    "vue-router": "4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.1",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^18.11.19",
    "@types/qs": "^6.9.7",
    "@vitejs/plugin-vue": "^4.0.0",
    "eslint": "^8.33.0",
    "minimist": "^1.2.7",
    "node-deploy": "github:beansmile/node-deploy",
    "only-allow": "^1.1.1",
    "postcss-html": "^1.5.0",
    "postcss-px-to-viewport-8-plugin": "^1.1.7",
    "sass": "^1.58.0",
    "stylelint": "^14.16.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-order": "^6.0.1",
    "typescript": "^4.9.3",
    "vite": "^4.1.0",
    "vite-plugin-checker": "^0.5.5",
    "vue-tsc": "^1.0.24"
  }
}
