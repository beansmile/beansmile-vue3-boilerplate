{
  "name": "vite-project",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "staging": "vue-tsc && vite build --mode staging",
    "build": "vue-tsc && vite build --mode production",
    "deploy:staging": "node ./scripts/deploy-h5.cjs --mode staging",
    "deploy:production": "node ./scripts/deploy-h5.cjs --mode production",
    "preview": "vite preview",
    "preinstall": "only-allow pnpm",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:ts": "vue-tsc",
    "lint:style": "stylelint \"**/*.{scss,vue}\""
  },
  "dependencies": {
    "axios": "^1.4.0",
    "dayjs": "^1.11.9",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.6",
    "qs": "^6.11.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^18.17.1",
    "@types/qs": "^6.9.7",
    "@vitejs/plugin-vue": "^4.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "minimist": "^1.2.8",
    "node-deploy": "git+https://github.com/beansmile/node-deploy.git",
    "only-allow": "^1.1.1",
    "postcss-html": "^1.5.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.2",
    "sass": "^1.64.1",
    "stylelint": "^14.16.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-order": "^6.0.3",
    "typescript": "^4.9.5",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.7",
    "vite-plugin-checker": "^0.5.6",
    "vue-tsc": "^1.8.8"
  }
}
